// Local administrator policy generated by Wallpaper Sync's installer.
// The helper independently checks the sender UID and logind seat0 session.
// A systemd user worker need not itself belong to a graphical session scope.
polkit.addRule(function(action, subject) {
    if ((action.id === "io.github.mouge.wallpaper-sync.apply" ||
         action.id === "io.github.mouge.wallpaper-sync.restore") &&
        subject.user === @USERNAME@) {
        return polkit.Result.YES;
    }
});
